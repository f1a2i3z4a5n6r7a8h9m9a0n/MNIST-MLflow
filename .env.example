# Copy to .env. Fill these privately; never commit .env.
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=
DAGSHUB_USER_TOKEN=
# For organization-owned repos, use your personal username here.
MLFLOW_TRACKING_USERNAME=
# Optional: copy the exact URI shown by DagsHub; must match owner/repo.
MLFLOW_TRACKING_URI=
